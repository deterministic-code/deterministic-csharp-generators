app:
  build:
    context: .
  ports:
    - '${HOST_PORT:-4003}:4000'
  environment:
    - ASPNETCORE_ENVIRONMENT=Production
    - ASPNETCORE_URLS=http://+:4000
    - DETERMINISTIC_TRACE=${DETERMINISTIC_TRACE:-}
  healthcheck:
    test: ['CMD-SHELL', 'curl -fsS http://localhost:4000/api/health || exit 1']
    interval: 5s
    timeout: 3s
    retries: 6
    start_period: 5s
  labels:
    - 'deterministic.language=csharp'
