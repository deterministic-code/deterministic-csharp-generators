FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src
COPY {{MULTILANG_PREFIX}}{{PROJECT_NAME}}.csproj ./
RUN dotnet restore {{PROJECT_NAME}}.csproj
COPY {{COPY_ALL_SRC}} ./
# === BEGIN MIGRATE_COPY — see PATCH_PLAN in create-migrate-scripts.mjs ===
# === END MIGRATE_COPY ===
RUN dotnet publish {{PROJECT_NAME}}.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/publish ./
# === BEGIN MIGRATE_RUNTIME_COPY — see PATCH_PLAN in create-migrate-scripts.mjs ===
# === END MIGRATE_RUNTIME_COPY ===
COPY {{MULTILANG_PREFIX}}scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
EXPOSE 4000
ENV ASPNETCORE_URLS=http://+:4000
HEALTHCHECK --interval=5s --timeout=3s --start-period=5s --retries=6 \
  CMD curl -fsS http://localhost:4000/api/health || exit 1
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["dotnet", "{{PROJECT_NAME}}.dll"]
