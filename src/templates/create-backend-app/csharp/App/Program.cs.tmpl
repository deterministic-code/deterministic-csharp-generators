// === BEGIN APP_DB_IMPORTS — see PATCH_PLAN in create-migrate-scripts.mjs ===
// === END APP_DB_IMPORTS ===

// NoClobber: real env vars win over .env, matching the ts/rust lanes; must run before CreateBuilder so ASPNETCORE_URLS from .env reaches Kestrel.
DotNetEnv.Env.NoClobber().Load();

var builder = WebApplication.CreateBuilder(args);
builder.Services.AddSingleton<IHealthCheckService, HealthCheckService>();
// === BEGIN APP_BEFORE_HOOK — see PATCH_PLAN in create-migrate-scripts.mjs ===
// === END APP_BEFORE_HOOK ===

var app = builder.Build();

app.MapGet("/api/health", (IHealthCheckService h) => h.Check());
// === BEGIN APP_AFTER_HOOK — see PATCH_PLAN in create-migrate-scripts.mjs ===
// === END APP_AFTER_HOOK ===

app.Run();

public interface IHealthCheckService
{
    object Check();
}

public sealed class HealthCheckService : IHealthCheckService
{
    public object Check() => new { ok = true };
}
